-- Porcelain Photo Booth database schema (ADR-0009). Version 1 (M03);
-- version 2 (M04) adds template assets and the assets each revision uses;
-- version 3 (M05) adds editor drafts and bundled assets; version 4 (M06)
-- camera originals and their commit journal; version 5 (M07) guest
-- sessions, their photos and finished photos.
--
-- Rules enforced here as well as in the domain, so a defect elsewhere can
-- never store an invalid event: foreign keys with explicit actions, CHECK
-- constraints mirroring EventLimits, one default template per event and
-- immutable template revisions. Changing anything here needs a schema
-- version bump, a migration step, a new schema dump and a seeded fixture
-- (tool/check.sh and test/drift enforce this).

import '../../domain/models/booth_event.dart';
import '../../domain/repositories/session_repository.dart';
import '../../domain/repositories/template_store.dart';
import '../../domain/services/camera_service.dart';
import '../../domain/template/template_assets.dart';
import '../../domain/value_objects/appearance.dart';
import '../../domain/value_objects/orientation.dart';
import 'converters.dart';

-- This device's booth (A-05 BoothProfile). One row, created with the
-- database.
CREATE TABLE booth_profiles (
  id TEXT NOT NULL PRIMARY KEY CHECK (length(id) = 36),
  name TEXT NOT NULL CHECK (length(trim(name)) BETWEEN 1 AND 40),
  -- Mapped explicitly: SQLite reads any type name containing "INT" (as in
  -- "PorcelainThemeProfile") as an integer, so ENUMNAME would store indexes.
  theme_profile TEXT NOT NULL MAPPED BY `themeProfileByName`
    CHECK (theme_profile IN ('porcelainStudio', 'lightOak', 'darkroomWalnut')),
  contrast_preference ENUMNAME(ContrastPreference) NOT NULL
    CHECK (contrast_preference IN ('system', 'standard', 'high')),
  motion_preference ENUMNAME(MotionPreference) NOT NULL
    CHECK (motion_preference IN ('system', 'reduced')),
  default_lens ENUMNAME(CameraLens) NOT NULL
    CHECK (default_lens IN ('front', 'back', 'external')),
  default_mirror_preview BOOLEAN NOT NULL
    CHECK (default_mirror_preview IN (0, 1)),
  default_mirror_output BOOLEAN NOT NULL
    CHECK (default_mirror_output IN (0, 1)),
  default_orientation ENUMNAME(GuestOrientationPreference) NOT NULL
    CHECK (default_orientation IN ('portrait', 'landscape')),
  default_output_format ENUMNAME(OutputFormat) NOT NULL
    CHECK (default_output_format IN ('jpeg', 'png')),
  default_jpeg_quality INTEGER NOT NULL
    CHECK (default_jpeg_quality BETWEEN 80 AND 100),
  created_at DATETIME NOT NULL,
  updated_at DATETIME NOT NULL
) AS BoothProfileRow;

-- App-wide state. Exactly one row (id = 1), created with the database.
CREATE TABLE app_settings (
  id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
  booth_profile_id TEXT NOT NULL
    REFERENCES booth_profiles (id) ON DELETE RESTRICT,
  -- Null until first-run setup finishes.
  setup_completed_at DATETIME,
  -- The event Booth Mode is running; null while the Studio is in use.
  booth_event_id TEXT REFERENCES events (id) ON DELETE SET NULL
) AS AppSettingsRow;

-- Operator access (A-12): the recovery code's slow, salted verifier and the
-- failed-attempt counters behind lockouts. The PIN's own verifier is kept
-- in platform secure storage, not here. Exactly one row (id = 1).
CREATE TABLE operator_access (
  id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
  recovery_verifier TEXT,
  pin_failures INTEGER NOT NULL DEFAULT 0 CHECK (pin_failures >= 0),
  pin_last_failure_at DATETIME,
  recovery_failures INTEGER NOT NULL DEFAULT 0 CHECK (recovery_failures >= 0),
  recovery_last_failure_at DATETIME
) AS OperatorAccessRow;

-- Templates (A-05). Written by the template library from M04/M05.
CREATE TABLE templates (
  id TEXT NOT NULL PRIMARY KEY CHECK (length(id) = 36),
  display_name TEXT NOT NULL
    CHECK (length(trim(display_name)) BETWEEN 1 AND 80),
  category TEXT CHECK (category IS NULL OR length(category) <= 40),
  created_at DATETIME NOT NULL,
  updated_at DATETIME NOT NULL,
  archived_at DATETIME
) AS TemplateRow;

-- Immutable template revisions (A-05, A-15). Page size and photo slot count
-- summarise the revision's manifest, so events can be validated without
-- parsing it. The manifest path is relative to managed storage.
CREATE TABLE template_revisions (
  id TEXT NOT NULL PRIMARY KEY CHECK (length(id) = 36),
  template_id TEXT NOT NULL REFERENCES templates (id) ON DELETE RESTRICT,
  revision_number INTEGER NOT NULL CHECK (revision_number >= 1),
  document_schema_version INTEGER NOT NULL
    CHECK (document_schema_version >= 1),
  manifest_path TEXT NOT NULL
    CHECK (length(manifest_path) BETWEEN 1 AND 255
      AND manifest_path NOT LIKE '/%'
      AND manifest_path NOT LIKE '%..%'
      AND instr(manifest_path, char(92)) = 0),
  checksum TEXT NOT NULL CHECK (length(checksum) = 64),
  page_width_px INTEGER NOT NULL CHECK (page_width_px BETWEEN 1 AND 20000),
  page_height_px INTEGER NOT NULL CHECK (page_height_px BETWEEN 1 AND 20000),
  photo_slot_count INTEGER NOT NULL CHECK (photo_slot_count BETWEEN 0 AND 8),
  created_at DATETIME NOT NULL,
  UNIQUE (template_id, revision_number)
) AS TemplateRevisionRow;

CREATE TRIGGER template_revisions_are_immutable
  BEFORE UPDATE ON template_revisions
BEGIN
  SELECT RAISE(ABORT, 'template revisions are immutable');
END;

-- Template assets (A-05 Asset, ADR-0010), version 2. Content-addressed: the
-- id is the lowercase hex SHA-256 of the file, which is stored once at
-- assets/<id>.<extension>, so a changed file can never pass for the old one.
-- Kind and MIME type follow from the media type. Image sizes are as decoded,
-- with any EXIF orientation applied. Limits mirror AssetLimits.
CREATE TABLE assets (
  id TEXT NOT NULL PRIMARY KEY
    CHECK (length(id) = 64 AND id NOT GLOB '*[^0-9a-f]*'),
  media_type ENUMNAME(AssetMediaType) NOT NULL
    CHECK (media_type IN ('png', 'jpeg', 'ttf', 'otf')),
  relative_path TEXT NOT NULL UNIQUE
    CHECK (relative_path = 'assets/' || id || '.' || CASE media_type
      WHEN 'png' THEN 'png' WHEN 'jpeg' THEN 'jpg'
      WHEN 'ttf' THEN 'ttf' WHEN 'otf' THEN 'otf' END),
  byte_length INTEGER NOT NULL CHECK (byte_length BETWEEN 1 AND 52428800),
  width_px INTEGER CHECK (width_px IS NULL OR width_px BETWEEN 1 AND 12000),
  height_px INTEGER CHECK (height_px IS NULL OR height_px BETWEEN 1 AND 12000),
  display_name TEXT
    CHECK (display_name IS NULL OR length(display_name) BETWEEN 1 AND 120),
  origin ENUMNAME(AssetOrigin) NOT NULL
    CHECK (origin IN ('imported', 'package', 'bundled')),
  created_at DATETIME NOT NULL,
  CHECK ((media_type IN ('png', 'jpeg'))
    = (width_px IS NOT NULL AND height_px IS NOT NULL)),
  CHECK (media_type IN ('png', 'jpeg') OR byte_length <= 20971520)
) AS AssetRow;

-- Version 3: what an asset is never changes; the name the asset browser
-- shows may (S08). Documents keep the name they recorded.
CREATE TRIGGER asset_content_is_immutable
  BEFORE UPDATE OF id, media_type, relative_path, byte_length, width_px,
    height_px, origin, created_at ON assets
BEGIN
  SELECT RAISE(ABORT, 'assets are immutable');
END;

-- The assets each template revision uses (version 2). Deleting a revision
-- removes its rows; an asset cannot be deleted while a revision uses it.
CREATE TABLE template_revision_assets (
  template_revision_id TEXT NOT NULL
    REFERENCES template_revisions (id) ON DELETE CASCADE,
  asset_id TEXT NOT NULL REFERENCES assets (id) ON DELETE RESTRICT,
  PRIMARY KEY (template_revision_id, asset_id)
) AS TemplateRevisionAssetRow;

CREATE INDEX template_revision_assets_by_asset
  ON template_revision_assets (asset_id);

-- Unsaved editor work, one per template (version 3, A-08 autosave). The
-- document is canonical template JSON (at most 1 MB); it becomes a revision
-- only when the operator saves. Deleting the template or the revision it
-- started from removes it.
CREATE TABLE template_drafts (
  template_id TEXT NOT NULL PRIMARY KEY
    REFERENCES templates (id) ON DELETE CASCADE,
  base_revision_id TEXT NOT NULL
    REFERENCES template_revisions (id) ON DELETE CASCADE,
  document TEXT NOT NULL CHECK (length(document) BETWEEN 2 AND 1048576),
  updated_at DATETIME NOT NULL
) AS TemplateDraftRow;

-- Events (P-05, A-05). Limits mirror EventLimits.
CREATE TABLE events (
  id TEXT NOT NULL PRIMARY KEY CHECK (length(id) = 36),
  booth_profile_id TEXT NOT NULL
    REFERENCES booth_profiles (id) ON DELETE RESTRICT,
  title TEXT NOT NULL CHECK (length(trim(title)) BETWEEN 1 AND 80),
  event_date TEXT MAPPED BY `const CalendarDateConverter()`
    CHECK (event_date IS NULL
      OR event_date GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'),
  venue TEXT CHECK (venue IS NULL OR length(venue) <= 80),
  notes TEXT CHECK (notes IS NULL OR length(notes) <= 1000),
  status ENUMNAME(EventStatus) NOT NULL
    CHECK (status IN ('draft', 'active', 'archived')),
  lens ENUMNAME(CameraLens) NOT NULL
    CHECK (lens IN ('front', 'back', 'external')),
  mirror_preview BOOLEAN NOT NULL CHECK (mirror_preview IN (0, 1)),
  mirror_output BOOLEAN NOT NULL CHECK (mirror_output IN (0, 1)),
  guest_orientation ENUMNAME(GuestOrientationPreference) NOT NULL
    CHECK (guest_orientation IN ('portrait', 'landscape')),
  shot_count INTEGER NOT NULL CHECK (shot_count BETWEEN 1 AND 4),
  countdown_seconds INTEGER NOT NULL CHECK (countdown_seconds BETWEEN 2 AND 10),
  shot_interval_seconds INTEGER NOT NULL
    CHECK (shot_interval_seconds BETWEEN 1 AND 10),
  retake_policy ENUMNAME(RetakePolicy) NOT NULL
    CHECK (retake_policy IN ('none', 'perShot', 'wholeSession')),
  retake_limit INTEGER NOT NULL,
  welcome_title TEXT CHECK (welcome_title IS NULL OR length(welcome_title) <= 60),
  welcome_message TEXT
    CHECK (welcome_message IS NULL OR length(welcome_message) <= 200),
  consent_text TEXT CHECK (consent_text IS NULL OR length(consent_text) <= 400),
  guest_chooses_template BOOLEAN NOT NULL
    CHECK (guest_chooses_template IN (0, 1)),
  finish_timeout_seconds INTEGER NOT NULL
    CHECK (finish_timeout_seconds BETWEEN 10 AND 120),
  theme_override TEXT MAPPED BY `themeProfileByName`
    CHECK (theme_override IS NULL
      OR theme_override IN ('porcelainStudio', 'lightOak', 'darkroomWalnut')),
  output_format ENUMNAME(OutputFormat) NOT NULL
    CHECK (output_format IN ('jpeg', 'png')),
  jpeg_quality INTEGER NOT NULL CHECK (jpeg_quality BETWEEN 80 AND 100),
  retention_mode ENUMNAME(RetentionMode) NOT NULL
    CHECK (retention_mode IN ('keepUntilDeleted', 'deleteAfterDays')),
  retention_days INTEGER,
  created_at DATETIME NOT NULL,
  updated_at DATETIME NOT NULL,
  archived_at DATETIME,
  CHECK ((retake_policy = 'none' AND retake_limit = 0)
    OR (retake_policy <> 'none' AND retake_limit BETWEEN 1 AND 5)),
  CHECK ((retention_mode = 'keepUntilDeleted' AND retention_days IS NULL)
    OR (retention_mode = 'deleteAfterDays'
      AND retention_days BETWEEN 1 AND 365)),
  CHECK ((status = 'archived') = (archived_at IS NOT NULL))
) AS EventRow;

CREATE INDEX events_by_status ON events (status, updated_at);

-- The template revisions an event offers guests, in order (A-05
-- EventTemplate). At most 12, at most one default; deleting an event
-- removes its rows, while a referenced revision cannot be deleted.
CREATE TABLE event_templates (
  event_id TEXT NOT NULL REFERENCES events (id) ON DELETE CASCADE,
  template_revision_id TEXT NOT NULL
    REFERENCES template_revisions (id) ON DELETE RESTRICT,
  position INTEGER NOT NULL CHECK (position BETWEEN 0 AND 11),
  is_default BOOLEAN NOT NULL CHECK (is_default IN (0, 1)),
  PRIMARY KEY (event_id, template_revision_id),
  UNIQUE (event_id, position)
) AS EventTemplateRow;

CREATE UNIQUE INDEX event_templates_one_default
  ON event_templates (event_id) WHERE is_default = 1;

CREATE INDEX event_templates_by_revision
  ON event_templates (template_revision_id);

-- Camera originals (version 4; A-05 CapturedPhoto, A-11, M06). A row is
-- written only once its file, originals/<id>.jpg, has been staged, read
-- back, fully decoded and renamed into place; neither ever changes again.
-- Sizes are as decoded, with any EXIF orientation applied.
CREATE TABLE original_photos (
  id TEXT NOT NULL PRIMARY KEY
    CHECK (length(id) BETWEEN 1 AND 64 AND id NOT GLOB '*[^0-9A-Za-z-]*'),
  relative_path TEXT NOT NULL UNIQUE
    CHECK (relative_path = 'originals/' || id || '.jpg'),
  width_px INTEGER NOT NULL CHECK (width_px BETWEEN 1 AND 20000),
  height_px INTEGER NOT NULL CHECK (height_px BETWEEN 1 AND 20000),
  byte_length INTEGER NOT NULL CHECK (byte_length BETWEEN 1 AND 104857600),
  sha256 TEXT NOT NULL
    CHECK (length(sha256) = 64 AND sha256 NOT GLOB '*[^0-9a-f]*'),
  lens ENUMNAME(CameraLens) NOT NULL
    CHECK (lens IN ('front', 'back', 'external')),
  sensor_orientation INTEGER NOT NULL
    CHECK (sensor_orientation IN (0, 90, 180, 270)),
  device_orientation ENUMNAME(CaptureOrientation) NOT NULL
    CHECK (device_orientation IN ('portraitUp', 'landscapeLeft',
      'portraitDown', 'landscapeRight', 'unknown')),
  exif_orientation INTEGER
    CHECK (exif_orientation IS NULL OR exif_orientation BETWEEN 1 AND 8),
  mirror_preview BOOLEAN NOT NULL CHECK (mirror_preview IN (0, 1)),
  mirror_output BOOLEAN NOT NULL CHECK (mirror_output IN (0, 1)),
  origin ENUMNAME(CaptureOrigin) NOT NULL
    CHECK (origin IN ('diagnostics', 'session', 'legacy')),
  captured_at DATETIME NOT NULL,
  committed_at DATETIME NOT NULL
) AS OriginalPhotoRow;

CREATE INDEX original_photos_by_time ON original_photos (captured_at);

CREATE TRIGGER original_photos_are_immutable
  BEFORE UPDATE ON original_photos
BEGIN
  SELECT RAISE(ABORT, 'originals are immutable');
END;

-- Originals being committed (version 4; A-11 journal). A row is written
-- before the file, and removed in the transaction that adds the original's
-- row. One left at startup belongs to a commit the app never finished; it
-- carries the checksum and the record (JSON) needed to finish or undo it.
CREATE TABLE pending_original_commits (
  id TEXT NOT NULL PRIMARY KEY
    CHECK (length(id) BETWEEN 1 AND 64 AND id NOT GLOB '*[^0-9A-Za-z-]*'),
  sha256 TEXT NOT NULL
    CHECK (length(sha256) = 64 AND sha256 NOT GLOB '*[^0-9a-f]*'),
  byte_length INTEGER NOT NULL CHECK (byte_length >= 1),
  metadata TEXT NOT NULL CHECK (length(metadata) BETWEEN 2 AND 65536),
  started_at DATETIME NOT NULL
) AS PendingOriginalCommitRow;

-- Guest sessions (version 5; A-05 CaptureSession, A-10). Each is frozen to
-- one event and one template revision when it starts; `plan_json` keeps the
-- frozen settings (JSON). Only the status columns change afterwards, and
-- a completed session never changes again.
CREATE TABLE capture_sessions (
  id TEXT NOT NULL PRIMARY KEY CHECK (length(id) = 36),
  event_id TEXT NOT NULL REFERENCES events (id) ON DELETE RESTRICT,
  template_revision_id TEXT NOT NULL
    REFERENCES template_revisions (id) ON DELETE RESTRICT,
  planned_shots INTEGER NOT NULL CHECK (planned_shots BETWEEN 1 AND 4),
  plan_json TEXT NOT NULL CHECK (length(plan_json) BETWEEN 2 AND 65536),
  status ENUMNAME(SessionStatus) NOT NULL
    CHECK (status IN ('capturing', 'reviewing', 'rendering', 'completed',
      'abandoned', 'failed')),
  end_reason ENUMNAME(SessionEndReason)
    CHECK (end_reason IS NULL OR end_reason IN ('interrupted', 'timedOut',
      'operatorExit', 'problem', 'renderFailed')),
  render_attempts INTEGER NOT NULL DEFAULT 0 CHECK (render_attempts >= 0),
  output_id TEXT CHECK (output_id IS NULL OR length(output_id) = 36),
  started_at DATETIME NOT NULL,
  updated_at DATETIME NOT NULL,
  ended_at DATETIME,
  CHECK ((status IN ('completed', 'abandoned', 'failed'))
    = (ended_at IS NOT NULL)),
  CHECK ((status = 'completed') = (output_id IS NOT NULL)),
  CHECK ((status IN ('abandoned', 'failed')) = (end_reason IS NOT NULL))
) AS CaptureSessionRow;

CREATE INDEX capture_sessions_by_event
  ON capture_sessions (event_id, started_at);

CREATE TRIGGER capture_session_plans_are_immutable
  BEFORE UPDATE OF id, event_id, template_revision_id, planned_shots,
    plan_json, started_at ON capture_sessions
BEGIN
  SELECT RAISE(ABORT, 'a session is frozen to its plan');
END;

CREATE TRIGGER finished_sessions_are_immutable
  BEFORE UPDATE ON capture_sessions
  WHEN OLD.status IN ('completed', 'abandoned', 'failed')
BEGIN
  SELECT RAISE(ABORT, 'a finished session never changes');
END;

-- Photos of a session (version 5; A-05 CapturedPhoto): one row per
-- attempt, never changed. The photo used for a shot is its latest attempt;
-- a retake adds a row and keeps the earlier original (AC-0703).
CREATE TABLE session_photos (
  session_id TEXT NOT NULL REFERENCES capture_sessions (id) ON DELETE RESTRICT,
  shot_index INTEGER NOT NULL CHECK (shot_index BETWEEN 0 AND 3),
  attempt INTEGER NOT NULL CHECK (attempt >= 1),
  round INTEGER NOT NULL CHECK (round >= 0 AND round < attempt),
  slot_index INTEGER NOT NULL CHECK (slot_index BETWEEN 0 AND 7),
  original_id TEXT NOT NULL UNIQUE
    REFERENCES original_photos (id) ON DELETE RESTRICT,
  captured_at DATETIME NOT NULL,
  PRIMARY KEY (session_id, shot_index, attempt)
) AS SessionPhotoRow;

CREATE TRIGGER session_photos_are_immutable
  BEFORE UPDATE ON session_photos
BEGIN
  SELECT RAISE(ABORT, 'session photos are immutable');
END;

-- Finished photos (version 5; A-05 RenderedOutput): the verified file in
-- managed storage and its facts. Never changed; a new render is a new row.
CREATE TABLE session_outputs (
  id TEXT NOT NULL PRIMARY KEY CHECK (length(id) = 36),
  session_id TEXT NOT NULL REFERENCES capture_sessions (id) ON DELETE RESTRICT,
  relative_path TEXT NOT NULL UNIQUE
    CHECK (relative_path = 'outputs/' || id
      || CASE format WHEN 'jpeg' THEN '.jpg' ELSE '.png' END),
  sha256 TEXT NOT NULL
    CHECK (length(sha256) = 64 AND sha256 NOT GLOB '*[^0-9a-f]*'),
  byte_length INTEGER NOT NULL CHECK (byte_length >= 1),
  width_px INTEGER NOT NULL CHECK (width_px BETWEEN 1 AND 20000),
  height_px INTEGER NOT NULL CHECK (height_px BETWEEN 1 AND 20000),
  format ENUMNAME(OutputFormat) NOT NULL CHECK (format IN ('jpeg', 'png')),
  render_version INTEGER NOT NULL CHECK (render_version >= 1),
  created_at DATETIME NOT NULL
) AS SessionOutputRow;

CREATE INDEX session_outputs_by_session
  ON session_outputs (session_id, created_at);

CREATE TRIGGER session_outputs_are_immutable
  BEFORE UPDATE ON session_outputs
BEGIN
  SELECT RAISE(ABORT, 'finished photos are immutable');
END;
