<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+): nothing in the app's storage leaves the tablet
     through Google cloud backup or device-to-device transfer. Guest photos,
     events and the operator PIN verifier stay on this device (first-run
     privacy promise, ADR-0009); the app's own verified backup arrives in
     M10. Secure-storage values would not decrypt on another device anyway:
     their keys live in this device's Android Keystore. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
